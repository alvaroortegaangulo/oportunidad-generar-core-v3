  <Sequence DisplayName="test_generar_ipf" sap2010:Annotation.AnnotationText="Wrapper local S11 para validar el contrato de oportunidad-generar-ipf.xaml. Prepara rutas y datos IPF de ejemplo, invoca el submodulo y deja una copia de plantilla en .local\test-output.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="RutaSalida" />
      <Variable x:TypeArguments="x:String" Name="RutaPlantillaIPF" />
      <Variable x:TypeArguments="x:String" Name="RutaIPF" />
      <Variable x:TypeArguments="x:String" Name="NumeroSF" />
      <Variable x:TypeArguments="x:String" Name="NumeroSFLeido" />
    </Sequence.Variables>
    <ui:MultipleAssign DisplayName="00 Preparar rutas y datos de prueba IPF">
      <ui:MultipleAssign.AssignOperations>
        <scg:List x:TypeArguments="ui:AssignOperation" Capacity="5">
          <ui:AssignOperation>
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[RutaSalida]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Path.GetFullPath(Path.Combine(Environment.CurrentDirectory, ".local", "test-output"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation>
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[RutaPlantillaIPF]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Path.GetFullPath(Path.Combine(Environment.CurrentDirectory, "ficheros-auxiliares", "Plantilla IPF.xlsx"))]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation>
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[RutaIPF]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[Path.Combine(RutaSalida, "IPF_20250256445_test.xlsx")]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation>
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[NumeroSF]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">20250256445</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
        </scg:List>
      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>
    <ui:CreateDirectory ContinueOnError="{x:Null}" Output="{x:Null}" DisplayName="01 Crear carpeta local de salida" Path="[RutaSalida]" />
    <ui:LogMessage DisplayName="02 Registrar inicio de prueba IPF" Level="[UiPath.Core.Activities.LogLevel.Info]" Message="[&quot;Inicio test IPF | Plantilla=&quot; + RutaPlantillaIPF + &quot; | IPF=&quot; + RutaIPF]" />
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="03 Invocar oportunidad-generar-ipf.xaml con datos de ejemplo" UnSafe="False" WorkflowFileName="oportunidad-generar-ipf.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_RutaPlantillaIPF">[RutaPlantillaIPF]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_RutaIPF">[RutaIPF]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_NumeroSF">[NumeroSF]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFRequestType">Invoice</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFBillType">Fixed</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFCompanyIssuer">Connectis ICT Services SAU</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SFAccountName">SERVICIOS A LA INFRAESTRUCTURA</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SAPCodigoCliente">461530</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SAPCodigoPEPWBS">ZEV-PCE0012-1001</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SAPNombreJefeProyecto">PM Test</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFMoneda">EUR</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SAPPedidoSalesOrder">714603126</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFPO">PVR-OC-0005647</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFSummaryText">Hito 1 : Integracion de las Bandas de Reclamo</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFTextNarrative">Hito 1 : Integracion de las Bandas de Reclamo</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFImporteNeto">22320,40</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_IPFComentariosFacturacion">Enviar copia de las facturas a responsable del proyecto.</InArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_NumeroSFLeido">[NumeroSFLeido]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:LogMessage DisplayName="04 Registrar fin de prueba IPF" Level="[UiPath.Core.Activities.LogLevel.Info]" Message="[&quot;Fin test IPF | IPF=&quot; + RutaIPF + &quot; | NumeroSFLeido=&quot; + NumeroSFLeido]" />
