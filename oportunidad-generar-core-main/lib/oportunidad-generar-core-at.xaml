      <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Preparar cabecera mensual CORE AT" Language="CSharp" Code="var tabla = new System.Data.DataTable();&#xD;&#xA;if (arg_MesesPPO != null)&#xD;&#xA;{&#xD;&#xA;    int indiceColumna = 1;&#xD;&#xA;    foreach (System.Data.DataRow mes in arg_MesesPPO.Rows)&#xD;&#xA;    {&#xD;&#xA;        tabla.Columns.Add(&quot;M&quot; + indiceColumna.ToString(), typeof(object));&#xD;&#xA;        indiceColumna++;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (tabla.Columns.Count &gt; 0)&#xD;&#xA;    {&#xD;&#xA;        var fila = tabla.NewRow();&#xD;&#xA;        int indiceMes = 0;&#xD;&#xA;        foreach (System.Data.DataRow mes in arg_MesesPPO.Rows)&#xD;&#xA;        {&#xD;&#xA;            string textoFecha = System.Convert.ToString(mes[&quot;Fecha&quot;]).Trim();&#xD;&#xA;            System.DateTime fecha;&#xD;&#xA;            if (System.DateTime.TryParse(textoFecha, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out fecha))&#xD;&#xA;            {&#xD;&#xA;                fila[indiceMes] = fecha.ToOADate();&#xD;&#xA;            }&#xD;&#xA;            else&#xD;&#xA;            {&#xD;&#xA;                fila[indiceMes] = textoFecha;&#xD;&#xA;            }&#xD;&#xA;            indiceMes++;&#xD;&#xA;        }&#xD;&#xA;        tabla.Rows.Add(fila);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;arg_CabeceraMeses = tabla;">
