    <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Validar capacidad mensual antes de escribir AT" Language="CSharp" sap2010:WorkflowViewState.IdRef="InvokeCode_E04_AT_01">
      <ui:InvokeCode.Code><![CDATA[
if (arg_CapacidadMesesResources <= 0 || arg_CapacidadMesesCostPlanning <= 0 || arg_CapacidadMesesMonthlyView <= 0)
{
    throw new System.Exception("No se ha detectado capacidad mensual valida en la plantilla CORE AT. Resources=" + arg_CapacidadMesesResources.ToString() + ", Cost Planning=" + arg_CapacidadMesesCostPlanning.ToString() + ", Monthly View=" + arg_CapacidadMesesMonthlyView.ToString() + ".");
}
if (arg_ResourcesDuracionMeses > arg_CapacidadMesesResources)
{
    throw new System.Exception("La duracion Resources del PPO (" + arg_ResourcesDuracionMeses.ToString() + " meses) supera la capacidad real de la plantilla CORE AT (" + arg_CapacidadMesesResources.ToString() + " meses).");
}
if (arg_CostPlanningDuracionMeses > arg_CapacidadMesesCostPlanning)
{
    throw new System.Exception("La duracion Cost Planning del PPO (" + arg_CostPlanningDuracionMeses.ToString() + " meses) supera la capacidad real de la plantilla CORE AT (" + arg_CapacidadMesesCostPlanning.ToString() + " meses).");
}
int headerMonths = arg_CabeceraMesesPPO == null ? 0 : arg_CabeceraMesesPPO.Columns.Count;
if (headerMonths > arg_CapacidadMesesMonthlyView)
{
    throw new System.Exception("La cabecera mensual del PPO (" + headerMonths.ToString() + " meses) supera la capacidad real de Monthly View en la plantilla CORE AT (" + arg_CapacidadMesesMonthlyView.ToString() + " meses).");
}
      ]]></ui:InvokeCode.Code>
