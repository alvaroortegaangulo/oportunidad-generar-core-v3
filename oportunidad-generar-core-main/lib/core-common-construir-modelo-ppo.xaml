      <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Normalizar cabecera Hoja de datos por etiquetas de negocio" Language="CSharp" Code="// Resuelve la cabecera del PPO por semantica de etiquetas, no por version de plantilla.&#xD;&#xA;string Texto(object valor)&#xD;&#xA;{&#xD;&#xA;    if (valor == null) return string.Empty;&#xD;&#xA;    if (valor == System.DBNull.Value) return string.Empty;&#xD;&#xA;    return System.Convert.ToString(valor).Trim();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string Normalizar(string texto)&#xD;&#xA;{&#xD;&#xA;    string normalizado = (texto ?? string.Empty).Normalize(System.Text.NormalizationForm.FormD);&#xD;&#xA;    var limpio = new System.Text.StringBuilder();&#xD;&#xA;    foreach (char caracter in normalizado)&#xD;&#xA;    {&#xD;&#xA;        if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(caracter) == System.Globalization.UnicodeCategory.NonSpacingMark) continue;&#xD;&#xA;        if (char.IsLetterOrDigit(caracter)) limpio.Append(char.ToLowerInvariant(caracter));&#xD;&#xA;    }&#xD;&#xA;    return limpio.ToString();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;object ValorCelda(System.Data.DataRow fila)&#xD;&#xA;{&#xD;&#xA;    if (arg_HojaDatos == null) return null;&#xD;&#xA;    if (arg_HojaDatos.Columns.Count &gt; 1) return fila[1];&#xD;&#xA;    if (arg_HojaDatos.Columns.Count &gt; 0) return fila[0];&#xD;&#xA;    return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;object ValorPorEtiqueta(bool exacta, params string[] etiquetas)&#xD;&#xA;{&#xD;&#xA;    if (arg_HojaDatos == null) return null;&#xD;&#xA;    for (int i = 0; i &lt; arg_HojaDatos.Rows.Count; i++)&#xD;&#xA;    {&#xD;&#xA;        var fila = arg_HojaDatos.Rows[i];&#xD;&#xA;        string etiqueta = arg_HojaDatos.Columns.Count &gt; 1 ? Normalizar(Texto(fila[0])) : string.Empty;&#xD;&#xA;        if (string.IsNullOrWhiteSpace(etiqueta)) continue;&#xD;&#xA;        foreach (string etiquetaBuscada in etiquetas)&#xD;&#xA;        {&#xD;&#xA;            string buscada = Normalizar(etiquetaBuscada);&#xD;&#xA;            if (string.IsNullOrWhiteSpace(buscada)) continue;&#xD;&#xA;            if (etiqueta == buscada) return ValorCelda(fila);&#xD;&#xA;            if (!exacta)&#xD;&#xA;            {&#xD;&#xA;                if (etiqueta.Contains(buscada)) return ValorCelda(fila);&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;object ValorFila(int filaExcel)&#xD;&#xA;{&#xD;&#xA;    if (arg_HojaDatos == null) return null;&#xD;&#xA;    int indice = filaExcel - 8;&#xD;&#xA;    if (indice &lt; 0) return null;&#xD;&#xA;    if (indice &gt;= arg_HojaDatos.Rows.Count) return null;&#xD;&#xA;    return ValorCelda(arg_HojaDatos.Rows[indice]);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;object Primero(params object[] valores)&#xD;&#xA;{&#xD;&#xA;    foreach (object valor in valores)&#xD;&#xA;    {&#xD;&#xA;        if (!string.IsNullOrWhiteSpace(Texto(valor))) return valor;&#xD;&#xA;    }&#xD;&#xA;    return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;object CodigoOportunidad()&#xD;&#xA;{&#xD;&#xA;    object porEtiqueta = Primero(ValorPorEtiqueta(false, &quot;Opportunity Code&quot;, &quot;Opportunity Number&quot;, &quot;Codigo Oferta Proyecto&quot;, &quot;Codigo Oferta/Proyecto&quot;, &quot;Codigo Oportunidad&quot;));&#xD;&#xA;    if (!string.IsNullOrWhiteSpace(Texto(porEtiqueta))) return porEtiqueta;&#xD;&#xA;    return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;object InferirTipoPep(object pepEntrada, object servicioEntrada)&#xD;&#xA;{&#xD;&#xA;    string pep = Texto(pepEntrada).ToUpperInvariant();&#xD;&#xA;    if (pep == &quot;AT&quot;) return &quot;AT&quot;;&#xD;&#xA;    if (pep == &quot;PC&quot;) return &quot;PC&quot;;&#xD;&#xA;    string servicio = Texto(servicioEntrada).ToUpperInvariant();&#xD;&#xA;    if (servicio.Contains(&quot;AT&quot;)) return &quot;AT&quot;;&#xD;&#xA;    if (servicio.Contains(&quot;FIXED&quot;)) return &quot;PC&quot;;&#xD;&#xA;    if (servicio.Contains(&quot;PC&quot;)) return &quot;PC&quot;;&#xD;&#xA;    return pepEntrada;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;arg_CompaniaPPO = Primero(ValorPorEtiqueta(true, &quot;Company&quot;, &quot;Entidad Presentadora&quot;, &quot;Compania&quot;, &quot;Compañia&quot;, &quot;Sociedad&quot;), ValorFila(8));&#xD;&#xA;arg_UnidadPPO = Primero(ValorPorEtiqueta(true, &quot;Unidad Negocio&quot;, &quot;Business Unit&quot;), ValorFila(9));&#xD;&#xA;arg_LocalizacionPPO = Primero(ValorPorEtiqueta(true, &quot;Customer Location&quot;, &quot;Oficina&quot;, &quot;Location&quot;, &quot;Localizacion&quot;), ValorFila(10));&#xD;&#xA;arg_TipoServicioPPO = Primero(ValorPorEtiqueta(true, &quot;Project Service Type&quot;, &quot;Project/Service Type&quot;, &quot;Tipo Servicio&quot;), ValorFila(11), ValorFila(13));&#xD;&#xA;object pepDetectado = Primero(ValorPorEtiqueta(true, &quot;PEP Type&quot;, &quot;Tipo de Contratacion&quot;, &quot;Tipo Contratacion&quot;), ValorFila(12), ValorFila(15));&#xD;&#xA;arg_TipoPepPPO = InferirTipoPep(pepDetectado, arg_TipoServicioPPO);&#xD;&#xA;arg_PortfolioPPO = Primero(ValorPorEtiqueta(true, &quot;Porfolio&quot;, &quot;Portfolio&quot;, &quot;Tipo Producto&quot;), ValorFila(14));&#xD;&#xA;arg_PracticaPPO = Primero(ValorPorEtiqueta(true, &quot;Practice&quot;, &quot;Sector&quot;), ValorFila(15), ValorFila(8));&#xD;&#xA;arg_SubpracticaPPO = Primero(ValorPorEtiqueta(true, &quot;Subpractice&quot;, &quot;Zona&quot;), ValorFila(16), ValorFila(12));&#xD;&#xA;arg_TipoOportunidadPPO = Primero(ValorPorEtiqueta(true, &quot;Opportunity Type&quot;, &quot;Tipo de Contratacion&quot;, &quot;Tipo Contratacion&quot;), arg_TipoPepPPO, ValorFila(17), ValorFila(15));&#xD;&#xA;arg_AccountManagerPPO = Primero(ValorPorEtiqueta(true, &quot;Account Manager&quot;, &quot;Responsable Comercial&quot;), ValorFila(18), ValorFila(16));&#xD;&#xA;arg_SolicitantePPO = Primero(ValorPorEtiqueta(true, &quot;Applicant&quot;, &quot;Responsable Oferta&quot;), ValorFila(19), ValorFila(17));&#xD;&#xA;arg_OrigenSubpracticaPPO = Primero(ValorPorEtiqueta(true, &quot;Subpractice Origin&