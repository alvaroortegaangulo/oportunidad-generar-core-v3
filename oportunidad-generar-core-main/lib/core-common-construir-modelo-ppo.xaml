null;&#xD;&#xA;    foreach (System.Data.DataRow fila in arg_dtCabeceraPPO.Rows)&#xD;&#xA;    {&#xD;&#xA;        if (string.Equals(Texto(fila[&quot;Campo&quot;]), campo, System.StringComparison.OrdinalIgnoreCase)) return fila;&#xD;&#xA;    }&#xD;&#xA;    return null;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;var filaPresupuesto = BuscarFila(&quot;orderAmount&quot;);&#xD;&#xA;var filaSintesis = BuscarFila(&quot;orderAmountFallback&quot;);&#xD;&#xA;if (filaPresupuesto != null)&#xD;&#xA;{&#xD;&#xA;    object valorPresupuesto = filaPresupuesto.Table.Columns.Contains(&quot;Valor&quot;) ? filaPresupuesto[&quot;Valor&quot;] : null;&#xD;&#xA;    object valorSintesis = (filaSintesis != null &amp;&amp; filaSintesis.Table.Columns.Contains(&quot;Valor&quot;)) ? filaSintesis[&quot;Valor&quot;] : null;&#xD;&#xA;    double numeroPresupuesto;&#xD;&#xA;    double numeroSintesis;&#xD;&#xA;    bool hayPresupuesto = TryNumero(valorPresupuesto, out numeroPresupuesto);&#xD;&#xA;    bool haySintesis = TryNumero(valorSintesis, out numeroSintesis);&#xD;&#xA;    object valorElegido = valorPresupuesto;&#xD;&#xA;    string origenElegido = &quot;Presupuesto!X8&quot;;&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(Texto(valorPresupuesto)) &amp;&amp; !string.IsNullOrWhiteSpace(Texto(valorSintesis)))&#xD;&#xA;    {&#xD;&#xA;        valorElegido = valorSintesis;&#xD;&#xA;        origenElegido = &quot;Sintesis Precio!D12&quot;;&#xD;&#xA;    }&#xD;&#xA;    else if (hayPresupuesto &amp;&amp; haySintesis &amp;&amp; numeroSintesis &gt; numeroPresupuesto)&#xD;&#xA;    {&#xD;&#xA;        valorElegido = valorSintesis;&#xD;&#xA;        origenElegido = &quot;Sintesis Precio!D12 (mayor que Presupuesto!X8)&quot;;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (filaPresupuesto.Table.Columns.Contains(&quot;Valor&quot;)) filaPresupuesto[&quot;Valor&quot;] = valorElegido ?? System.DBNull.Value;&#xD;&#xA;    if (filaPresupuesto.Table.Columns.Contains(&quot;Origen&quot;)) filaPresupuesto[&quot;Origen&quot;] = origenElegido;&#xD;