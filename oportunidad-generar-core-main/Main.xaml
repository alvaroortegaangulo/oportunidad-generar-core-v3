    </Sequence>
    <Sequence DisplayName="01 Validar inputs locales" sap2010:Annotation.AnnotationText="Falla temprano si falta una carpeta, workflow, PPO o plantilla. Las rutas de PPO son nombres exactos de la entrega, no reglas adaptadas al parser.">
      <ui:FolderExistsX DisplayName="Comprobar carpeta data input" Exists="[ExisteInput]" Path="[RutaInput]" />
      <If DisplayName="Validar carpeta data input" Condition="[Not ExisteInput]">
        <If.Then>
          <Throw DisplayName="Error carpeta data input inexistente" Exception="[New Exception(&quot;No existe la carpeta data\input resuelta desde el proyecto: &quot; + RutaInput)]" />
        </If.Then>
      </If>
      <ui:FolderExistsX DisplayName="Comprobar carpeta data templates" Exists="[ExisteTemplates]" Path="[RutaTemplates]" />
      <If DisplayName="Validar carpeta data templates" Condition="[Not ExisteTemplates]">
        <If.Then>
          <Throw DisplayName="Error carpeta data templates inexistente" Exception="[New Exception(&quot;No existe la carpeta data\templates resuelta desde el proyecto: &quot; + RutaTemplates)]" />
        </If.Then>
      </If>
      <ui:FolderExistsX DisplayName="Comprobar carpeta lib" Exists="[ExisteLib]" Path="[RutaLib]" />
      <If DisplayName="Validar carpeta lib" Condition="[Not ExisteLib]">
        <If.Then>
          <Throw DisplayName="Error carpeta lib inexistente" Exception="[New Exception(&quot;No existe la carpeta lib resuelta desde el proyecto: &quot; + RutaLib)]" />
        </If.Then>
      </If>
      <If DisplayName="Validar fachada CORE en ejecucion fuente" Condition="[Directory.GetFiles(RutaLib, &quot;*.xaml&quot;).Length &gt; 0 AndAlso Not File.Exists(RutaWorkflowCore)]">
        <If.Then>
          <Throw DisplayName="Error fachada CORE inexistente" Exception="[New Exception(&quot;No existe lib\oportunidad-generar-core.xaml: &quot; + RutaWorkflowCore)]" />
        </If.Then>
      </If>
      <ui:FileExistsX DisplayName="Comprobar PPO PC 20250256445" Exists="[ExistePPOPC]" Path="[RutaPPOPC]" />
      <If DisplayName="Validar PPO PC exacto" Condition="[Not ExistePPOPC]">
        <If.Then>
          <Throw DisplayName="Error PPO PC inexistente" Exception="[New Exception(&quot;No existe el PPO PC esperado para 20250256445: &quot; + RutaPPOPC)]" />
        </If.Then>
      </If>
      <ui:FileExistsX DisplayName="Comprobar PPO AT 20251160543" Exists="[ExistePPOAT]" Path="[RutaPPOAT]" />
      <If DisplayName="Validar PPO AT exacto" Condition="[Not ExistePPOAT]">
        <If.Then>
          <Throw DisplayName="Error PPO AT inexistente" Exception="[New Exception(&quot;No existe el PPO AT esperado para 20251160543: &quot; + RutaPPOAT)]" />
        </If.Then>
      </If>
      <ui:FileExistsX DisplayName="Comprobar plantilla CORE PC" Exists="[ExistePlantillaPC]" Path="[RutaPlantillaCorePC]" />
      <If DisplayName="Validar plantilla CORE PC" Condition="[Not ExistePlantillaPC]">
        <If.Then>
          <Throw DisplayName="Error plantilla CORE PC inexistente" Exception="[New Exception(&quot;No existe la plantilla CORE PC: &quot; + RutaPlantillaCorePC)]" />
        </If.Then>
      </If>
      <ui:FileExistsX DisplayName="Comprobar plantilla CORE AT" Exists="[ExistePlantillaAT]" Path="[RutaPlantillaCoreAT]" />
      <If DisplayName="Validar plantilla CORE AT" Condition="[Not ExistePlantillaAT]">
        <If.Then>
          <Throw DisplayName="Error plantilla CORE AT inexistente" Exception="[New Exception(&quot;No existe la plantilla CORE AT: &quot; + RutaPlantillaCoreAT)]" />
        </If.Then>
      </If>
      <ui:LogMessage DisplayName="Registrar validacion local OK" Level="[UiPath.Core.Activities.LogLevel.Info]" Message="[&quot;Main E07 | validacion local OK | PPO PC=&quot; + RutaPPOPC + &quot; | PPO AT=&quot; + RutaPPOAT]" />
    </Sequence>
