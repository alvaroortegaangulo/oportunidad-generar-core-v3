    <Sequence DisplayName="00 Preparar rutas" sap2010:Annotation.AnnotationText="Construye todas las rutas desde Environment.CurrentDirectory. En ejecucion empaquetada debe apuntar al content del paquete UiPath, por eso no se usan rutas absolutas.">
      <ui:MultipleAssign DisplayName="Resolver rutas relativas del proyecto">
        <ui:MultipleAssign.AssignOperations>
          <scg:List x:TypeArguments="ui:AssignOperation" Capacity="12">
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaProyecto]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.GetFullPath(Environment.CurrentDirectory)]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaInput]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.GetFullPath(Path.Combine(RutaProyecto, "data", "input"))]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaTemplates]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.GetFullPath(Path.Combine(RutaProyecto, "data", "templates"))]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaOutput]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.GetFullPath(Path.Combine(RutaProyecto, "data", "output"))]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaLib]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.GetFullPath(Path.Combine(RutaProyecto, "lib"))]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaWorkflowCore]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.Combine(RutaLib, "oportunidad-generar-core.xaml")]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaPPOPC]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.Combine(RutaInput, "20250256445" + New String(" "c, 2) + "PPO_NuevaTerminalPVR v2 1.xlsm")]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaPPOAT]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.Combine(RutaInput, "20251160543_PPO_CEducaci" + ChrW(243).ToString() + "n_AMS_SI_Lote 2_v01.xlsm")]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaPlantillaCorePC]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.Combine(RutaTemplates, "CORE_PC_template.xlsx")]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaPlantillaCoreAT]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.Combine(RutaTemplates, "CORE_AT_template.xlsx")]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaCOREPC]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.Combine(RutaOutput, "CORE_PC_20250256445.xlsx")]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
            <ui:AssignOperation>
              <ui:AssignOperation.To>
                <OutArgument x:TypeArguments="x:String">[RutaCOREAT]</OutArgument>
              </ui:AssignOperation.To>
              <ui:AssignOperation.Value>
                <InArgument x:TypeArguments="x:String">[Path.Combine(RutaOutput, "CORE_AT_20251160543.xlsx")]</InArgument>
              </ui:AssignOperation.Value>
            </ui:AssignOperation>
          </scg:List>
        </ui:MultipleAssign.AssignOperations>
      </ui:MultipleAssign>
      <ui:CreateDirectory ContinueOnError="{x:Null}" Output="{x:Null}" DisplayName="Crear data output si no existe" Path="[RutaOutput]" />
