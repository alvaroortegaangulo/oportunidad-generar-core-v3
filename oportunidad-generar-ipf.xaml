          <ui:LogMessage DisplayName="Registrar inicio del módulo IPF" Level="[UiPath.Core.Activities.LogLevel.Info]" Message="[&quot;Inicio oportunidad-generar-ipf | NumeroSF=&quot; + numeroSFTrabajo + &quot; | IPF destino=&quot; + rutaIPFTrabajo]" />
          <Sequence DisplayName="01 Validar entradas técnicas IPF" sap2010:Annotation.AnnotationText="Objetivo: comprobar solo las condiciones técnicas que bloquean la generación. Los datos funcionales de cabecera y facturación pueden venir vacíos y se escriben como texto rojo o vacío según el mapa IPF.">
            <If DisplayName="Validar plantilla IPF informada" Condition="[String.IsNullOrWhiteSpace(rutaPlantillaIPFTrabajo)]">
              <If.Then>
                <Throw DisplayName="Error plantilla IPF no informada" Exception="[New Exception(&quot;in_RutaPlantillaIPF no está informada.&quot;)]" />
              </If.Then>
            </If>
            <ui:FileExistsX DisplayName="Comprobar existencia de plantilla IPF" Exists="[existePlantillaIPFTrabajo]" Path="[rutaPlantillaIPFTrabajo]" />
            <If DisplayName="Validar existencia de plantilla IPF" Condition="[Not existePlantillaIPFTrabajo]">
              <If.Then>
                <Throw DisplayName="Error plantilla IPF inexistente" Exception="[New Exception(&quot;No existe la plantilla IPF indicada: &quot; + rutaPlantillaIPFTrabajo)]" />
              </If.Then>
            </If>
            <If DisplayName="Validar ruta IPF informada" Condition="[String.IsNullOrWhiteSpace(rutaIPFTrabajo)]">
              <If.Then>
                <Throw DisplayName="Error ruta IPF no informada" Exception="[New Exception(&quot;in_RutaIPF no está informada.&quot;)]" />
              </If.Then>
            </If>
            <Assign DisplayName="Obtener carpeta destino del IPF">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[carpetaIPFTrabajo]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[System.IO.Path.GetDirectoryName(rutaIPFTrabajo)]</InArgument>
              </Assign.Value>
            </Assign>
            <If DisplayName="Validar carpeta destino informada" Condition="[String.IsNullOrWhiteSpace(carpetaIPFTrabajo)]">
              <If.Then>
                <Throw DisplayName="Error carpeta destino IPF no informada" Exception="[New Exception(&quot;in_RutaIPF debe incluir una carpeta destino completa: &quot; + rutaIPFTrabajo)]" />
              </If.Then>
            </If>
            <ui:FolderExistsX DisplayName="Comprobar existencia de carpeta destino IPF" Exists="[existeCarpetaIPFTrabajo]" Path="[carpetaIPFTrabajo]" />
            <If DisplayName="Validar existencia de carpeta destino IPF" Condition="[Not existeCarpetaIPFTrabajo]">
              <If.Then>
                <Throw DisplayName="Error carpeta destino IPF inexistente" Exception="[New Exception(&quot;La carpeta destino del IPF no existe. Debe crearla el proceso padre: &quot; + carpetaIPFTrabajo)]" />
              </If.Then>
            </If>
          </Sequence>
          <Sequence DisplayName="02 Copiar plantilla IPF a ruta destino" sap2010:Annotation.AnnotationText="Objetivo: crear el IPF de trabajo desde la plantilla recibida por el proceso padre. Salida: libro IPF listo para escritura S12.">
            <ui:CopyFile ContinueOnError="{x:Null}" DisplayName="Copiar plantilla IPF a ruta destino" Overwrite="True" Path="[rutaPlantillaIPFTrabajo]" Destination="[rutaIPFTrabajo]" />
          </Sequence>
          <Sequence DisplayName="03 Leer listas IPF" sap2010:Annotation.AnnotationText="Objetivo: leer las listas oficiales de la plantilla para validar Request Type, Bill Type, Company Issuer y Currency sin codificar valores ocultos. Entradas: hoja Lists del IPF copiado. Salida: tablas de listas para la utilidad de normalización.">
            <ui:ReadRange AddHeaders="False" DataTable="[dt_ListaRequestTypeIPF]" DisplayName="Leer lista Request Type" Range="B3:B5" SheetName="Lists" WorkbookPath="[rutaIPFTrabajo]" />
            <ui:ReadRange AddHeaders="False" DataTable="[dt_ListaBillTypeIPF]" DisplayName="Leer lista Bill Type" Range="C3:C8" SheetName="Lists" WorkbookPath="[rutaIPFTrabajo]" />
            <ui:ReadRange AddHeaders="False" DataTable="[dt_ListaCurrencyIPF]" DisplayName="Leer lista Currency" Range="D3:D7" SheetName="Lists" WorkbookPath="[rutaIPFTrabajo]" />
            <ui:ReadRange AddHeaders="False" DataTable="[dt_ListaCompanyIssuerIPF]" DisplayName="Leer lista Company Issuer" Range="Q5:Q43" SheetName="Lists" WorkbookPath="[rutaIPFTrabajo]" />
          </Sequence>
          <Sequence DisplayName="04 Preparar valores IPF" sap2010:Annotation.AnnotationText="Objetivo: normalizar listas, inferir Company Issuer por WBS cuando proceda y preparar los textos cortos de revisión. No abre Excel ni escribe celdas; la escritura queda en la secuencia 05.">
            <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Utilidad S12 - normalizar listas y valores IPF" Language="CSharp" Code="// Objetivo: validar listas IPF y preparar valores finales de Invoice Request.&#xD;&#xA;// Entradas: listas de plantilla y datos SAP/Salesforce/IPF aportados por el padre.&#xD;&#xA;// Salidas: valores normalizados y flags de rojo por celda IPF.&#xD;&#xA;// Regla: se usan valores por defecto solo cuando la plantilla los admite; los faltantes funcionales quedan marcados.&#xD;&#xA;// No hace: no escribe Excel ni inventa narrativa, hitos o importes.&#xD;&#xA;string Texto(object valor)&#xD;&#xA;{&#xD;&#xA;    if (valor == null || valor == System.DBNull.Value)&#xD;&#xA;    {&#xD;&#xA;        return string.Empty;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return System.Convert.ToString(valor).Trim();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Las listas se leen desde la plantilla para respetar las validaciones oficiales.&#xD;&#xA;System.Collections.Generic.List&lt;string&gt; LeerLista(System.Data.DataTable tabla)&#xD;&#xA;{&#xD;&#xA;    var valores = new System.Collections.Generic.List&lt;string&gt;();&#xD;&#xA;&#xD;&#xA;    if (tabla == null)&#xD;&#xA;    {&#xD;&#xA;        return valores;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    foreach (System.Data.DataRow fila in tabla.Rows)&#xD;&#xA;    {&#xD;&#xA;        foreach (object celda in fila.ItemArray)&#xD;&#xA;        {&#xD;&#xA;            string texto = Texto(celda);&#xD;&#xA;&#xD;&#xA;            if (&#xD;&#xA;                !string.IsNullOrWhiteSpace(texto)&#xD;&#xA;                &amp;&amp; !System.Linq.Enumerable.Contains(&#xD;&#xA;                    valores,&#xD;&#xA;                    texto,&#xD;&#xA;                    System.StringComparer.OrdinalIgnoreCase&#xD;&#xA;                )&#xD;&#xA;            )&#xD;&#xA;            {&#xD;&#xA;                valores.Add(texto);&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return valores;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string BuscarEnLista(System.Collections.Generic.IEnumerable&lt;string&gt; lista, string valor)&#xD;&#xA;{&#xD;&#xA;    foreach (string candidato in lista)&#xD;&#xA;    {&#xD;&#xA;        if (string.Equals(candidato, valor, System.StringComparison.OrdinalIgnoreCase))&#xD;&#xA;        {&#xD;&#xA;            return candidato;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return string.Empty;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string ValorLista(&#xD;&#xA;    string entrada,&#xD;&#xA;    System.Collections.Generic.List&lt;string&gt; lista,&#xD;&#xA;    string defecto,&#xD;&#xA;    out bool error&#xD;&#xA;)&#xD;&#xA;{&#xD;&#xA;    string texto = Texto(entrada);&#xD;&#xA;    error = false;&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(texto))&#xD;&#xA;    {&#xD;&#xA;        return defecto;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    string encontrado = BuscarEnLista(lista, texto);&#xD;&#xA;&#xD;&#xA;    if (!string.IsNullOrWhiteSpace(encontrado))&#xD;&#xA;    {&#xD;&#xA;        return encontrado;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    error = true;&#xD;&#xA;    return defecto;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string InferirCompanyIssuer(string valorEntrada, string wbsEntrada)&#xD;&#xA;{&#xD;&#xA;    string texto = (Texto(valorEntrada) + &quot; &quot; + Texto(wbsEntrada)).ToUpperInvariant();&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(texto))&#xD;&#xA;    {&#xD;&#xA;        return string.Empty;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (texto.Contains(&quot;ROSETTA&quot;) || texto.Contains(&quot;ZEZ&quot;) || texto.Contains(&quot;EZZ&quot;))&#xD;&#xA;    {&#xD;&#xA;        return &quot;Global Rosetta&quot;;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (&#xD;&#xA;        texto.Contains(&quot;CONNECTIS&quot;)&#xD;&#xA;        || texto.Contains(&quot;ZEV&quot;)&#xD;&#xA;        || texto.Contains(&quot;ICT&quot;)&#xD;&#xA;        || texto.Contains(&quot; ZV&quot;)&#xD;&#xA;    )&#xD;&#xA;    {&#xD;&#xA;        return &quot;Connectis ICT Services SAU&quot;;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return string.Empty;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string ValorCompanyIssuer(&#xD;&#xA;    string entrada,&#xD;&#xA;    string wbs,&#xD;&#xA;    System.Collections.Generic.List&lt;string&gt; lista,&#xD;&#xA;    out bool error&#xD;&#xA;)&#xD;&#xA;{&#xD;&#xA;    string texto = Texto(entrada);&#xD;&#xA;    error = false;&#xD;&#xA;&#xD;&#xA;    if (!string.IsNullOrWhiteSpace(texto))&#xD;&#xA;    {&#xD;&#xA;        string encontrado = BuscarEnLista(lista, texto);&#xD;&#xA;&#xD;&#xA;        if (!string.IsNullOrWhiteSpace(encontrado))&#xD;&#xA;        {&#xD;&#xA;            return encontrado;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    string inferido = InferirCompanyIssuer(texto, wbs);&#xD;&#xA;&#xD;&#xA;    if (!string.IsNullOrWhiteSpace(inferido))&#xD;&#xA;    {&#xD;&#xA;        string encontradoInferido = BuscarEnLista(lista, inferido);&#xD;&#xA;&#xD;&#xA;        if (!string.IsNullOrWhiteSpace(encontradoInferido))&#xD;&#xA;        {&#xD;&#xA;            return encontradoInferido;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    error = true;&#xD;&#xA;    return &quot;Company issuer no disponible&quot;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string DatoObligatorio(string valor, string textoError, out bool error)&#xD;&#xA;{&#xD;&#xA;    string texto = Texto(valor);&#xD;&#xA;    error = string.IsNullOrWhiteSpace(texto);&#xD;&#xA;    return error ? textoError : texto;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;object ImporteNeto(string valor, out bool error)&#xD;&#xA;{&#xD;&#xA;    string texto = Texto(valor);&#xD;&#xA;    error = false;&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(texto))&#xD;&#xA;    {&#xD;&#xA;        return string.Empty;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    double numero;&#xD;&#xA;&#xD;&#xA;    if (&#xD;&#xA;        double.TryParse(&#xD;&#xA;            texto,&#xD;&#xA;            System.Globalization.NumberStyles.Any,&#xD;&#xA;            System.Globalization.CultureInfo.GetCultureInfo(&quot;es-ES&quot;),&#xD;&#xA;            out numero&#xD;&#xA;        )&#xD;&#xA;        || double.TryParse(&#xD;&#xA;            texto,&#xD;&#xA;            System.Globalization.NumberStyles.Any,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            out numero&#xD;&#xA;        )&#xD;&#xA;    )&#xD;&#xA;    {&#xD;&#xA;        return numero;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    string normalizado = texto.Replace(&quot;.&quot;, string.Empty).Replace(&quot;,&quot;, &quot;.&quot;);&#xD;&#xA;&#xD;&#xA;    if (&#xD;&#xA;        double.TryParse(&#xD;&#xA;            normalizado,&#xD;&#xA;            System.Globalization.NumberStyles.Any,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            out numero&#xD;&#xA;        )&#xD;&#xA;    )&#xD;&#xA;    {&#xD;&#xA;        return numero;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    error = true;&#xD;&#xA;    return &quot;Importe no válido&quot;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;var requestTypes = LeerLista(arg_dtRequestTypes);&#xD;&#xA;var billTypes = LeerLista(arg_dtBillTypes);&#xD;&#xA;var currencies = LeerLista(arg_dtCurrencies);&#xD;&#xA;var companyIssuers = LeerLista(arg_dtCompanyIssuers);&#xD;&#xA;&#xD;&#xA;bool errorTemporal;&#xD;&#xA;&#xD;&#xA;// A partir de aquí se resuelven valores finales y marcas de formato rojo.&#xD;&#xA;arg_RequestTypeValor = ValorLista(&#xD;&#xA;    arg_RequestTypeEntrada,&#xD;&#xA;    requestTypes,&#xD;&#xA;    &quot;Invoice&quot;,&#xD;&#xA;    out errorTemporal&#xD;&#xA;);&#xD;&#xA;arg_RequestTypeError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_BillTypeValor = ValorLista(arg_BillTypeEntrada, billTypes, &quot;Fixed&quot;, out errorTemporal);&#xD;&#xA;arg_BillTypeError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_CurrencyValor = ValorLista(arg_CurrencyEntrada, currencies, &quot;EUR&quot;, out errorTemporal);&#xD;&#xA;arg_CurrencyError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_CompanyIssuerValor = ValorCompanyIssuer(&#xD;&#xA;    arg_CompanyIssuerEntrada,&#xD;&#xA;    arg_WBSEntrada,&#xD;&#xA;    companyIssuers,&#xD;&#xA;    out errorTemporal&#xD;&#xA;);&#xD;&#xA;arg_CompanyIssuerError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_CustomerValor = DatoObligatorio(&#xD;&#xA;    arg_CustomerEntrada,&#xD;&#xA;    &quot;Cliente no disponible&quot;,&#xD;&#xA;    out errorTemporal&#xD;&#xA;);&#xD;&#xA;arg_CustomerError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_SoldToValor = DatoObligatorio(&#xD;&#xA;    arg_SoldToEntrada,&#xD;&#xA;    &quot;Sold-to no disponible&quot;,&#xD;&#xA;    out errorTemporal&#xD;&#xA;);&#xD;&#xA;arg_SoldToError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_WBSValor = DatoObligatorio(arg_WBSEntrada, &quot;WBS no disponible&quot;, out errorTemporal);&#xD;&#xA;arg_WBSError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_RequestedByValor = DatoObligatorio(&#xD;&#xA;    arg_RequestedByEntrada,&#xD;&#xA;    &quot;Solicitante no disponible&quot;,&#xD;&#xA;    out errorTemporal&#xD;&#xA;);&#xD;&#xA;arg_RequestedByError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_SalesOrderValor = DatoObligatorio(&#xD;&#xA;    arg_SalesOrderEntrada,&#xD;&#xA;    &quot;Sales Order no disponible&quot;,&#xD;&#xA;    out errorTemporal&#xD;&#xA;);&#xD;&#xA;arg_SalesOrderError = errorTemporal;&#xD;&#xA;&#xD;&#xA;arg_POValor = Texto(arg_POEntrada);&#xD;&#xA;arg_LineaPOValor = string.IsNullOrWhiteSpace(arg_POValor)&#xD;&#xA;    ? string.Empty&#xD;&#xA;    : &quot;Pedido : &quot; + arg_POValor;&#xD;&#xA;arg_SummaryTextValor = Texto(arg_SummaryTextEntrada);&#xD;&#xA;arg_TextNarrativeValor = Texto(arg_TextNarrativeEntrada);&#xD;&#xA;arg_ComentariosValor = Texto(arg_ComentariosEntrada);&#xD;&#xA;arg_ImporteNetoValor = ImporteNeto(arg_ImporteNetoEntrada, out errorTemporal);&#xD;&#xA;arg_ImporteNetoError = errorTemporal;&#xD;&#xA;">              <ui:InvokeCode.Arguments>
                <scg:Dictionary x:TypeArguments="x:String, Argument">
                  <InArgument x:TypeArguments="sd:DataTable" x:Key="arg_dtRequestTypes">[dt_ListaRequestTypeIPF]</InArgument>
                  <InArgument x:TypeArguments="sd:DataTable" x:Key="arg_dtBillTypes">[dt_ListaBillTypeIPF]</InArgument>
                  <InArgument x:TypeArguments="sd:DataTable" x:Key="arg_dtCurrencies">[dt_ListaCurrencyIPF]</InArgument>
                  <InArgument x:TypeArguments="sd:DataTable" x:Key="arg_dtCompanyIssuers">[dt_ListaCompanyIssuerIPF]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_RequestTypeEntrada">[requestTypeTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_BillTypeEntrada">[billTypeTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_CompanyIssuerEntrada">[companyIssuerTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_CustomerEntrada">[accountNameTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_SoldToEntrada">[codigoClienteSAPTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_WBSEntrada">[codigoPEPTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_RequestedByEntrada">[nombreJefeProyectoTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_CurrencyEntrada">[monedaTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_SalesOrderEntrada">[pedidoSalesOrderTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_POEntrada">[poTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_SummaryTextEntrada">[summaryTextTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_TextNarrativeEntrada">[textNarrativeTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_ImporteNetoEntrada">[importeNetoTrabajo]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="arg_ComentariosEntrada">[comentariosFacturacionTrabajo]</InArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_RequestTypeValor">[ipfRequestTypeValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_BillTypeValor">[ipfBillTypeValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_CompanyIssuerValor">[ipfCompanyIssuerValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_CustomerValor">[ipfCustomerValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_SoldToValor">[ipfSoldToValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_WBSValor">[ipfWBSValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_RequestedByValor">[ipfRequestedByValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_CurrencyValor">[ipfCurrencyValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_SalesOrderValor">[ipfSalesOrderValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_POValor">[ipfPOValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_LineaPOValor">[ipfLineaPOValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_SummaryTextValor">[ipfSummaryTextValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_TextNarrativeValor">[ipfTextNarrativeValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:Object" x:Key="arg_ImporteNetoValor">[ipfImporteNetoValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="arg_ComentariosValor">[ipfComentariosValor]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="arg_RequestTypeError">[ipfRequestTypeError]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="arg_BillTypeError">[ipfBillTypeError]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="arg_CompanyIssuerError">[ipfCompanyIssuerError]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="arg_CustomerError">[ipfCustomerError]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="arg_SoldToError">[ipfSoldToError]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="arg_WBSError">[ipfWBSError]</OutArgument>
