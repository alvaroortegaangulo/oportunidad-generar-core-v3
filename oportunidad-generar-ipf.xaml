    <TryCatch DisplayName="Control de ejecución IPF" sap2010:Annotation.AnnotationText="Agrupa los errores técnicos del IPF y los devuelve al proceso padre. Los datos funcionales faltantes no bloquean; en S12 se escribirán como vacío o texto corto rojo según plantilla.">
      <TryCatch.Try>
        <Sequence DisplayName="Generar IPF de oportunidad">
          <Sequence DisplayName="00 Preparar datos locales para pruebas y ejecución" sap2010:Annotation.AnnotationText="Objetivo: pasar los argumentos IPF a variables locales. Entradas: contrato público recibido del proceso padre. Salida: variables de trabajo preparadas para validación y escritura.">
            <ui:MultipleAssign DisplayName="Inicializar variables locales IPF desde argumentos">
              <ui:MultipleAssign.AssignOperations>
                <scg:List x:TypeArguments="ui:AssignOperation" Capacity="20">
