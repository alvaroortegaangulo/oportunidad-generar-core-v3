          <Sequence DisplayName="05 Escribir IPF con actividades Excel" sap2010:Annotation.AnnotationText="Objetivo: rellenar Invoice Request con datos confirmados y limpiar los ejemplos de plantilla. Los obligatorios faltantes se marcan en rojo; narrativa, comentarios e importe solo se escriben si llegan informados.">
            <ueab:ExcelProcessScopeX DisplayName="Abrir Excel para escribir IPF">
              <ueab:ExcelProcessScopeX.Body>
                <ActivityAction x:TypeArguments="ui:IExcelProcess">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="ui:IExcelProcess" Name="ExcelProcessIPFS12" />
                  </ActivityAction.Argument>
                  <ueab:ExcelApplicationCard Password="{x:Null}" ReadFormatting="{x:Null}" AutoSave="True" DisplayName="Usar IPF para Invoice Request" ResizeWindow="None" WorkbookPath="[rutaIPFTrabajo]">
                    <ueab:ExcelApplicationCard.Body>
                      <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
                        <ActivityAction.Argument>
                          <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="ExcelIPF" />
                        </ActivityAction.Argument>
                        <Sequence DisplayName="Rellenar Invoice Request">
                          <ueab:ClearRangeX DisplayName="Vaciar dirección de facturación no confirmada C18:C24" TargetRange="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;C18:C24&quot;)]" />
                          <ueab:ClearRangeX DisplayName="Vaciar narrativa ejemplo C29:F38" TargetRange="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;C29:F38&quot;)]" />
                          <ueab:ClearRangeX DisplayName="Vaciar comentarios ejemplo F47:G57" TargetRange="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;F47:G57&quot;)]" />
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C3&quot;)]" DisplayName="Escribir Request Type C3" Value="[ipfRequestTypeValor]" />
                          <If DisplayName="Marcar Request Type rojo si entrada no válida" Condition="[ipfRequestTypeError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Request Type C3" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;C3&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C6&quot;)]" DisplayName="Escribir Bill Type C6" Value="[ipfBillTypeValor]" />
                          <If DisplayName="Marcar Bill Type rojo si entrada no válida" Condition="[ipfBillTypeError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Bill Type C6" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;C6&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C8&quot;)]" DisplayName="Escribir Company Issuer C8" Value="[ipfCompanyIssuerValor]" />
                          <If DisplayName="Marcar Company Issuer rojo si falta" Condition="[ipfCompanyIssuerError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Company Issuer C8" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;C8&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C11&quot;)]" DisplayName="Escribir Customer C11" Value="[ipfCustomerValor]" />
                          <If DisplayName="Marcar Customer rojo si falta" Condition="[ipfCustomerError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Customer C11" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;C11&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;F11&quot;)]" DisplayName="Escribir Sold-to F11" Value="[ipfSoldToValor]" />
                          <If DisplayName="Marcar Sold-to rojo si falta" Condition="[ipfSoldToError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Sold-to F11" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;F11&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;F14&quot;)]" DisplayName="Escribir PO F14 si existe" Value="[ipfPOValor]" />
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C16&quot;)]" DisplayName="Escribir Requested by C16" Value="[ipfRequestedByValor]" />
                          <If DisplayName="Marcar Requested by rojo si falta" Condition="[ipfRequestedByError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Requested by C16" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;C16&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;F16&quot;)]" DisplayName="Escribir Currency F16" Value="[ipfCurrencyValor]" />
                          <If DisplayName="Marcar Currency rojo si entrada no válida" Condition="[ipfCurrencyError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Currency F16" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;F16&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C26&quot;)]" DisplayName="Escribir Summary Text C26 si existe" Value="[ipfSummaryTextValor]" />
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C30&quot;)]" DisplayName="Escribir línea PO narrativa C30 si existe" Value="[ipfLineaPOValor]" />
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;C32&quot;)]" DisplayName="Escribir Text Narrative C32 si existe" Value="[ipfTextNarrativeValor]" />
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;F32&quot;)]" DisplayName="Escribir importe neto F32 si existe" Value="[ipfImporteNetoValor]" />
                          <If DisplayName="Marcar importe neto rojo si formato no válido" Condition="[ipfImporteNetoError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a importe neto F32" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;F32&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;D46&quot;)]" DisplayName="Escribir Sales Order D46" Value="[ipfSalesOrderValor]" />
                          <If DisplayName="Marcar Sales Order rojo si falta" Condition="[ipfSalesOrderError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a Sales Order D46" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;D46&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;D47&quot;)]" DisplayName="Escribir WBS D47" Value="[ipfWBSValor]" />
                          <If DisplayName="Marcar WBS rojo si falta" Condition="[ipfWBSError]">
                            <If.Then>
                              <ueab:FormatRangeX DisplayName="Aplicar rojo a WBS D47" Range="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Range(&quot;D47&quot;)]">
                                <ueab:FormatRangeX.Font>
                                  <ui:FontOptions Color="Red" FillColor="Transparent" FontFamilyName="Calibri" Size="11" Style="Regular" UnderlineStyle="None" />
                                </ueab:FormatRangeX.Font>
                              </ueab:FormatRangeX>
                            </If.Then>
                          </If>
                          <ueab:WriteCellX Cell="[ExcelIPF.Sheet(&quot;Invoice Request&quot;).Cell(&quot;F47&quot;)]" DisplayName="Escribir comentarios facturación F47 si existen" Value="[ipfComentariosValor]" />
                          <ueab:SaveExcelFileX DisplayName="Guardar IPF" Workbook="[ExcelIPF]" />
                        </Sequence>
                      </ActivityAction>
                    </ueab:ExcelApplicationCard.Body>
                  </ueab:ExcelApplicationCard>
                </ActivityAction>
              </ueab:ExcelProcessScopeX.Body>
            </ueab:ExcelProcessScopeX>
          </Sequence>
          <Sequence DisplayName="06 Devolver salida y registrar fin">
            <Assign DisplayName="Devolver NumeroSF al proceso padre">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_NumeroSFLeido]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[numeroSFTrabajo]</InArgument>
              </Assign.Value>
            </Assign>
            <ui:LogMessage DisplayName="Registrar fin OK IPF S12" Level="[UiPath.Core.Activities.LogLevel.Info]" Message="[&quot;OK - IPF generado en: &quot; + rutaIPFTrabajo + &quot; | NumeroSF=&quot; + numeroSFTrabajo + &quot; | RequestType=&quot; + ipfRequestTypeValor + &quot; | BillType=&quot; + ipfBillTypeValor + &quot; | Moneda=&quot; + ipfCurrencyValor]" />
          </Sequence>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="excepcion" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Gestionar error del submódulo IPF">
              <ui:LogMessage DisplayName="Registrar error del módulo IPF" Level="[UiPath.Core.Activities.LogLevel.Error]" Message="[&quot;ERROR oportunidad-generar-ipf | Plantilla=&quot; + rutaPlantillaIPFTrabajo + &quot; | IPF=&quot; + rutaIPFTrabajo + &quot; | Detalle=&quot; + excepcion.Message]" />
              <Rethrow DisplayName="Relanzar excepción al proceso padre" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
  </Sequence>
</Activity>
